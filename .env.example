# Copy this file to .env and fill in the values before building.

# Public URL of the live site (used for canonical links, sitemap.xml, robots.txt, social previews)
VITE_SITE_URL=https://www.menopauseindia.com

# Google Analytics 4 measurement ID (GA4 > Admin > Data streams). Leave blank to disable.
VITE_GA_ID=

# Google Search Console HTML-tag verification code (only the content="..." value). Leave blank if verifying via DNS.
VITE_GSC_VERIFICATION=

# Where phone-number, newsletter and contact form submissions are POSTed.
# See docs/google-sheets-leads.gs for a free Google Sheets setup. Leave blank to keep submissions in the browser console only (dev).
VITE_FORMS_ENDPOINT=
